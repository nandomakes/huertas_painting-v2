---
// Reference hero: navy panel on the left fading into a photo on the right,
// caps eyebrow, big H1, one-paragraph pitch, a "call" link, and a floating
// estimate card. The trust bar (TrustBar.astro) sits right underneath.
// `variant="page"` is the shorter inner-page version (breadcrumbs, no card).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CONTACT, IMAGES } from '../consts';
import Icon from './Icon.astro';

interface Props {
  variant?: 'home' | 'page';
  eyebrow?: string;
  title: string;
  sub?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** CSS object-position for the photo (keep the subject visible). */
  focus?: string;
  crumbs?: { href?: string; label: string }[];
}
const {
  variant = 'home',
  eyebrow,
  title,
  sub,
  image = IMAGES.hero.src,
  imageAlt = IMAGES.hero.alt,
  focus = '12% 50%',
  crumbs = [],
} = Astro.props;
const home = variant === 'home';
---

<section class:list={['hero relative bg-secondary text-paper', home ? 'hero-home' : 'hero-page']}>
  <!-- Photo: full-width on top on mobile, right ~60% on desktop. -->
  <div class:list={['relative overflow-hidden lg:absolute lg:inset-y-0 lg:right-0 lg:w-[54%] xl:w-[60%]', home ? 'aspect-[1178/624] lg:aspect-auto' : 'aspect-[16/8] lg:aspect-auto']}>
    <Picture
      src={image}
      alt={imageAlt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1178, 1600]}
      sizes="(min-width: 1024px) 60vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
      style={`object-position:${focus}`}
    />
  </div>
  <div class="hero-fade pointer-events-none absolute inset-0 hidden lg:block" aria-hidden="true"></div>

  <div class:list={['wrap relative', home ? 'pb-10 pt-10 lg:min-h-[38rem] lg:pb-20 lg:pt-20' : 'py-10 lg:min-h-[26rem] lg:py-20']}>
    <div class="max-w-[35rem] lg:max-w-[28.5rem] xl:max-w-[35rem]">
      {
        crumbs.length > 0 && (
          <nav class="reveal mb-5 text-[0.82rem] font-medium text-paper/75" aria-label="Breadcrumb">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <span class="mx-2 text-primary">/</span>}
                {c.href ? <a href={c.href} class="hover:text-primary">{c.label}</a> : <span class="text-paper" aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      {eyebrow && <p class="hero-eyebrow reveal eyebrow text-primary max-sm:text-[0.74rem] max-sm:tracking-[0.08em]">{eyebrow}</p>}
      {home ? <h1 class="reveal h-hero mt-4">{title}</h1> : <h1 class="reveal h-hero mt-4 !text-[clamp(2rem,1.3rem+2.4vw,3rem)]">{title}</h1>}
      {sub && <p class="reveal lead mt-6 text-paper/90">{sub}</p>}

      <div class="reveal mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={`tel:${CONTACT.phoneTel}`} class="hero-call group inline-flex items-center gap-3 font-display text-[1.05rem] font-semibold">
          <span class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-paper transition-colors group-hover:border-primary group-hover:bg-primary">
            <Icon name="phone" size={18} stroke={2} />
          </span>
          <span class="underline decoration-2 underline-offset-[6px] group-hover:text-primary">Call or text {CONTACT.phoneDisplay}</span>
        </a>
        {!home && <a href="#estimate" class="btn btn-primary max-sm:w-full">Schedule Free Estimate <Icon name="arrow" size={18} stroke={2} /></a>}
      </div>

      {
        home && (
          <div class="hero-card reveal relative z-10 mt-10 max-w-[22.5rem] overflow-hidden rounded-card bg-paper text-ink shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)]">
            <div class="bg-surface px-5 pb-4 pt-5">
              <p class="font-display text-[1.05rem] font-semibold">Free estimate, in your home</p>
              <p class="mt-1 text-[0.8rem] leading-snug text-muted">We measure, then send you a custom quote.</p>
            </div>
            <div class="p-5">
              <a href="#estimate" class="btn btn-primary w-full !py-4 text-[1.05rem]">
                Schedule Free Estimate <Icon name="arrow" size={18} stroke={2} />
              </a>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

