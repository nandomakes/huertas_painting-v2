---
// Reference "We're Proud to Preserve Historic Homes Since 2012": text and
// CTA left, media right with a caption. The reference's video becomes a
// real before & after from the client's gallery.
import { Image } from 'astro:assets';
import { GALLERY } from '../consts';
import Icon from './Icon.astro';

const photo = GALLERY.find((g) => g.file === 'before-after-kitchen-painting.jpg') ?? GALLERY[0];
---

<section class="feature section bg-surface">
  <div class="wrap grid items-center gap-10 md:grid-cols-2 md:gap-14">
    <div>
      <h2 class="reveal h2">Proud to Paint South Metro Homes Since 2018</h2>
      <p class="reveal mt-6 text-body">
        Huerta's Painting is a locally-owned and operated family business in Apple Valley, MN. Count on us for fair
        estimates, exceptional painting, and timely completion. We are known to not miss any detail — we take steps to
        care for your home from protection set-up to final clean-up, and we complete all projects to 100% satisfaction.
      </p>
      <p class="reveal mt-4 text-body">
        From a few rooms freshened up to a whole-home makeover, exterior repaints, popcorn ceiling removal and deck
        restoration — one team, one quote, one point of contact.
      </p>
      <div class="reveal mt-8">
        <a href="#estimate" class="btn btn-primary">Schedule Free Estimate <Icon name="calendar" size={18} stroke={1.8} /></a>
      </div>
    </div>
    <figure class="reveal">
      <a href="/gallery/" class="feature-media zoom-parent block overflow-hidden rounded-card">
        <Image src={photo.src} alt={photo.alt} widths={[560, 800]} sizes="(min-width: 768px) 32rem, 100vw" loading="lazy" class="zoom-img aspect-[800/540] w-full object-cover" />
      </a>
      <figcaption class="mt-3 text-[0.85rem] text-muted">
        Pictured: {photo.label.toLowerCase()} before &amp; after. <a href="/gallery/" class="font-semibold text-link hover:underline">See the gallery →</a>
      </figcaption>
    </figure>
  </div>
</section>
