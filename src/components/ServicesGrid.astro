---
// Reference services grid: centered title + divider, 3×2 photo cards
// (photo, title, two-line pitch, "Learn more →"), extra services line and
// an outlined "See all services" button.
import { Image } from 'astro:assets';
import { SERVICES } from '../consts';
import SectionHead from './SectionHead.astro';

interface Props {
  title?: string;
  exclude?: string;
}
const { title = 'Our South Metro House Painting Services', exclude } = Astro.props;
const items = SERVICES.filter((s) => s.slug !== exclude);
---

<section id="services" class="services section bg-paper">
  <div class="wrap">
    <SectionHead title={title} />
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-6 lg:mt-12 lg:grid-cols-3 lg:gap-7">
      {
        items.map((s) => (
          <li class="reveal">
            <a href={`/services/${s.slug}/`} class="service-card card zoom-parent lift group flex h-full flex-col overflow-hidden">
              <span class="block overflow-hidden">
                <Image
                  src={s.image}
                  alt={`${s.name} by Huerta's Painting`}
                  widths={[400, 590]}
                  sizes="(min-width: 1024px) 21rem, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  class="zoom-img aspect-[16/10] w-full object-cover"
                />
              </span>
              <span class="flex flex-1 flex-col items-center px-3 pb-4 pt-3 text-center sm:px-6 sm:pb-7 sm:pt-5">
                <h3 class="h3 text-heading max-sm:!text-[0.98rem]">{s.name}</h3>
                <p class="mt-3 hidden flex-1 text-[0.95rem] leading-[1.6] text-body sm:block">{s.short}</p>
                <span class="link-arrow mt-auto pt-2 max-sm:!text-[0.8rem] sm:pt-4">Learn more →</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="reveal mt-10 text-center">
      <a href="/services/" class="btn btn-outline">See All Services →</a>
    </div>
  </div>
</section>
