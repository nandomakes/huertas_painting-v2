---
// Review widget modelled on the reference's Trustindex block: a summary
// panel on the left (Google mark, short pitch, link to the full profile,
// Nextdoor / Facebook) and a carousel of review cards on the right —
// colored initial avatar, name, date, job tag, clamped quote with
// "Read more", and a "Verified review on Google" footer.
// No stars and no average rating anywhere (client request).
import { TESTIMONIALS, PROFILES } from '../consts';
import BrandIcon from './BrandIcon.astro';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  tone?: 'surface' | 'paper';
  limit?: number;
}
const { title = 'Loved by South Metro Homeowners', tone = 'surface', limit = TESTIMONIALS.length } = Astro.props;
const items = TESTIMONIALS.slice(0, limit);
const initials = (n: string) =>
  n
    .split(/\s+/)
    .filter((w) => /^[A-Za-z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
// Google-style avatar colors, cycled.
const avatarColors = ['#4285F4', '#0F9D58', '#DB4437', '#7B1FA2', '#F4B400', '#00897B', '#5C6BC0'];
---

<section id="reviews" class:list={['reviews section', tone === 'surface' ? 'bg-surface' : 'bg-paper']} data-carousel>
  <div class="wrap grid items-center gap-8 lg:grid-cols-[17rem_1fr] lg:gap-10">
    <!-- Summary panel -->
    <div class="reviews-summary text-center lg:text-left">
      <p class="reveal eyebrow text-muted">Client reviews</p>
      <h2 class="reveal h2 mt-2 !text-[clamp(1.6rem,1.2rem+1.3vw,2rem)]">{title}</h2>
      <a href={PROFILES.google} target="_blank" rel="noopener noreferrer" data-profile="google" class="reveal mt-5 inline-flex items-center gap-3 rounded-card border border-line bg-paper px-4 py-3 text-left transition-colors hover:border-primary">
        <BrandIcon name="google" size={30} />
        <span class="leading-tight">
          <span class="block font-display text-[0.98rem] font-semibold text-ink">Google Reviews</span>
          <span class="inline-flex items-center gap-1 text-[0.78rem] text-muted">Read them all on our profile <Icon name="external" size={12} stroke={2} /></span>
        </span>
      </a>
      <p class="reveal mt-4 text-[0.92rem] leading-relaxed text-body">
        Real words from clients in Apple Valley, Lakeville, Eagan, Farmington and beyond.
      </p>
      <p class="reveal mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[0.85rem] font-semibold text-ink lg:justify-start">
        <a href={PROFILES.nextdoor} target="_blank" rel="noopener noreferrer" data-profile="nextdoor" class="inline-flex items-center gap-1.5 hover:text-link"><BrandIcon name="nextdoor" size={18} /> Nextdoor</a>
        <a href={PROFILES.facebookReviews} target="_blank" rel="noopener noreferrer" data-profile="facebook" class="inline-flex items-center gap-1.5 hover:text-link"><BrandIcon name="facebook" size={18} /> Facebook</a>
      </p>
      <div class="reveal mt-6 hidden gap-2 lg:flex">
        <button type="button" data-prev class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-sm transition-colors hover:border-primary hover:text-link disabled:opacity-35" aria-label="Previous reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" data-next class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-sm transition-colors hover:border-primary hover:text-link disabled:opacity-35" aria-label="Next reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <!-- Cards -->
    <div class="min-w-0">
      <ul class="snap-row" data-track role="region" aria-label="Client reviews" tabindex="0">
        {
          items.map((t, i) => (
            <li class="w-[86%] sm:w-[calc((100%-1.5rem)/2)]">
              <figure class="review-card card flex h-full flex-col p-5">
                <figcaption class="flex items-center gap-3">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full font-display text-[0.95rem] font-semibold text-white" style={`background:${avatarColors[i % avatarColors.length]}`} aria-hidden="true">
                    {initials(t.author)}
                  </span>
                  <span class="min-w-0 leading-tight">
                    <span class="block truncate font-display font-semibold text-ink">{t.author}</span>
                    <span class="block text-[0.78rem] text-muted">{t.date}</span>
                  </span>
                  <BrandIcon name="google" size={22} class="ml-auto shrink-0" />
                </figcaption>
                <span class="mt-4 max-w-full self-start truncate rounded-full bg-surface px-2.5 py-1 text-[0.72rem] font-medium text-muted">{t.job}</span>
                <blockquote class="review-text mt-3 line-clamp-5 text-[0.93rem] leading-[1.6] text-body" data-clamp>{t.quote}</blockquote>
                <button type="button" class="mt-1.5 hidden self-start text-[0.85rem] font-semibold text-link hover:underline" data-more aria-expanded="false">Read more</button>
                <a href={PROFILES.google} target="_blank" rel="noopener noreferrer" data-profile="google" class="mt-auto flex items-center gap-1.5 border-t border-line pt-3.5 text-[0.76rem] font-medium text-muted hover:text-link">
                  <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true"><path fill="#1A73E8" d="M12 1.5l2.6 1.9 3.2-.1 1 3.1 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3.1-3.2-.1L12 22.5l-2.6-1.9-3.2.1-1-3.1-2.6-1.9 1-3.1-1-3.1 2.6-1.9 1-3.1 3.2.1z" /><path d="M8 12.2l2.6 2.6L16.2 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  Verified review on Google
                </a>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="mt-5 flex justify-center gap-2 lg:hidden">
        <button type="button" data-prev class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-sm disabled:opacity-35" aria-label="Previous reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" data-next class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-sm disabled:opacity-35" aria-label="Next reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // "Read more" only on quotes that are actually clamped.
  document.querySelectorAll<HTMLElement>('#reviews [data-clamp]').forEach((q) => {
    const btn = q.parentElement?.querySelector<HTMLButtonElement>('[data-more]');
    if (!btn) return;
    if (q.scrollHeight > q.clientHeight + 2) btn.classList.remove('hidden');
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      q.classList.toggle('line-clamp-5', open);
      btn.setAttribute('aria-expanded', String(!open));
      btn.textContent = open ? 'Read more' : 'Show less';
    });
  });
</script>
