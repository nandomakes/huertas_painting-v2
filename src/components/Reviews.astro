---
// Review carousel in the reference's widget format (white cards: name,
// quote, "Posted on Google"). No stars and no average rating — client
// request; the buttons underneath send visitors to the real profiles.
import { TESTIMONIALS, PROFILES } from '../consts';
import BrandIcon from './BrandIcon.astro';
import SectionHead from './SectionHead.astro';
import ProfileLinks from './ProfileLinks.astro';

interface Props {
  title?: string;
  tone?: 'surface' | 'paper';
  limit?: number;
}
const { title = 'What South Metro Homeowners Say', tone = 'surface', limit = TESTIMONIALS.length } = Astro.props;
const items = TESTIMONIALS.slice(0, limit);
const initials = (n: string) =>
  n
    .split(/\s+/)
    .filter((w) => /^[A-Za-z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
---

<section id="reviews" class:list={['reviews section', tone === 'surface' ? 'bg-surface' : 'bg-paper']} data-carousel>
  <div class="wrap">
    <SectionHead title={title} sub="Real words from real clients. Read every review on our Google, Nextdoor and Facebook pages." />

    <div class="relative mt-10">
      <ul class="snap-row" data-track role="region" aria-label="Client reviews" tabindex="0">
        {
          items.map((t) => (
            <li class="w-[86%] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
              <figure class="review-card card flex h-full flex-col p-6">
                <figcaption class="flex items-center gap-3">
                  <span class="review-avatar flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary font-display text-sm font-semibold text-paper" aria-hidden="true">
                    {initials(t.author)}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate font-display font-semibold text-ink">{t.author}</span>
                    <span class="block truncate text-[0.78rem] text-muted">{t.job}</span>
                  </span>
                  <BrandIcon name="google" size={20} class="ml-auto shrink-0" />
                </figcaption>
                <blockquote class="mt-4 flex-1 text-[0.92rem] leading-[1.65] text-body">“{t.quote}”</blockquote>
                <a href={PROFILES.google} target="_blank" rel="noopener noreferrer" data-profile="google" class="mt-5 text-[0.78rem] font-medium text-muted hover:text-link">
                  Posted on Google · {t.date}
                </a>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex justify-center gap-2">
        <button type="button" data-prev class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-sm transition-colors hover:border-primary hover:text-link disabled:opacity-35" aria-label="Previous reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" data-next class="carousel-btn flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-ink shadow-sm transition-colors hover:border-primary hover:text-link disabled:opacity-35" aria-label="Next reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <ProfileLinks class="reveal mt-8 justify-center" />
  </div>
</section>
