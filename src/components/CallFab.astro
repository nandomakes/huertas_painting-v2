---
// Mobile/tablet sticky action bar (as on the reference): Text · Call · Free Estimate.
import { CONTACT } from '../consts';
import Icon from './Icon.astro';
---

<div class="call-fab fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-line bg-paper shadow-[0_-8px_24px_-12px_rgba(0,0,0,0.25)] lg:hidden">
  <a href={CONTACT.smsHref} class="flex flex-col items-center justify-center gap-1 py-2.5 text-[0.72rem] font-semibold text-ink">
    <Icon name="chat" size={20} stroke={2} class="text-link" />
    Text Us
  </a>
  <a href={`tel:${CONTACT.phoneTel}`} class="flex flex-col items-center justify-center gap-1 border-x border-line py-2.5 text-[0.72rem] font-semibold text-ink">
    <Icon name="phone" size={20} stroke={2} class="text-link" />
    Call
  </a>
  <a href="#estimate" class="call-fab-cta flex items-center justify-center bg-primary py-2.5 font-display text-[0.8rem] font-semibold text-onPrimary">Free Estimate</a>
</div>
