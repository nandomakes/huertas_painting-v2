---
// Huerta's Painting logo. `light` = white lettering for dark surfaces
// (generated by scripts/build-brand-assets.mjs); default = original colors.
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-huertas-painting.png';
import logoLight from '../assets/images/logo-huertas-painting-light.png';

interface Props {
  class?: string;
  light?: boolean;
  loading?: 'eager' | 'lazy';
}
const { class: className = 'h-14 w-auto', light = false, loading = 'eager' } = Astro.props;
---

<Image
  src={light ? logoLight : logo}
  alt="Huerta's Painting — Residential Painting Services"
  widths={[175, 350]}
  sizes="175px"
  loading={loading}
  class:list={['block', className]}
/>
