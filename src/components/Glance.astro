---
// Reference "Paris Painting at a Glance" + "Twin Cities' Most Experienced
// Team": a fact card with city chips on the left, the local-SEO copy and the
// city links on the right. The four WordPress city pages lead the list.
import { CONTACT, AREA_PAGES, KEY_CITIES } from '../consts';
import Icon from './Icon.astro';

const facts = [
  { label: 'Painting since', value: '2018' },
  { label: 'Projects completed', value: '300+' },
  { label: 'Estimates', value: 'Free, in your home', href: '#estimate' },
  { label: 'Every project', value: 'Owner-supervised', href: '/about/' },
  { label: 'Coverage', value: 'Fully insured' },
  { label: 'Call or text', value: CONTACT.phoneDisplay, href: `tel:${CONTACT.phoneTel}` },
];
const zips: Record<string, string> = {
  'farmington-house-painting': '55024',
  'apple-valley-house-painting': '55124',
  'lakeville-house-painting': '55044',
  'eagan-house-painting': '55121 · 55122 · 55123',
};
const key = KEY_CITIES.map((slug) => AREA_PAGES.find((a) => a.slug === slug)!).filter(Boolean);
const others = AREA_PAGES.filter((a) => !KEY_CITIES.includes(a.slug));
---

<section id="areas" class="glance section bg-surface">
  <div class="wrap grid items-center gap-10 md:grid-cols-2 md:gap-14">
    <div class="reveal glance-card card p-6 sm:p-7">
      <h3 class="font-display text-[1.4rem] font-semibold text-ink">Huerta's Painting at a Glance</h3>
      <dl class="mt-5 grid grid-cols-2 gap-x-5">
        {
          facts.map((f) => (
            <div class="glance-fact border-t-2 border-primary py-3.5">
              <dt class="text-[0.72rem] font-medium uppercase tracking-[0.1em] text-muted">{f.label}</dt>
              <dd class="mt-1 font-display text-[1.05rem] font-semibold text-ink">
                {f.href ? <a href={f.href} class="underline decoration-primary decoration-2 underline-offset-4 hover:text-link">{f.value}</a> : f.value}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 text-[0.72rem] font-medium uppercase tracking-[0.1em] text-muted">Where we paint</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {AREA_PAGES.map((a) => <li><a href={`/${a.slug}/`} class="chip">{a.city}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="reveal h2">The South Metro's Family-Owned Painting Team</h2>
      <p class="reveal mt-6 text-body">
        Based in Apple Valley, we paint homes across Dakota County and the southern Twin Cities: interiors, exteriors,
        drywall and ceilings, and decks. Every project is personally overseen by founder Pedro Ramirez-Huerta, from the
        free in-home consultation to the final walkthrough.
      </p>
      <p class="reveal mt-6 font-medium text-ink">Where we paint most:</p>
      <ul class="reveal mt-3 grid gap-x-6 sm:grid-cols-2">
        {
          key.map((a) => (
            <li class="border-b border-line py-2.5">
              <a href={`/${a.slug}/`} class="group flex items-baseline justify-between gap-2">
                <span class="font-medium text-ink group-hover:text-link">{a.city}</span>
                <span class="text-[0.75rem] text-muted">{zips[a.slug]}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="reveal mt-5 text-body">
        Also {others.map((a, i) => (
          <>
            <a href={`/${a.slug}/`} class="text-link hover:underline">{a.city}</a>{i < others.length - 2 ? ', ' : i === others.length - 2 ? ' and ' : ''}
          </>
        ))}.
      </p>
      <div class="reveal mt-8">
        <a href="#estimate" class="btn btn-primary">Schedule Free Estimate <Icon name="calendar" size={18} stroke={1.8} /></a>
      </div>
    </div>
  </div>
</section>
