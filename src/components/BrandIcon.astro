---
// Filled brand marks for the review / social links. `mono` draws them in
// currentColor (footer icons); otherwise Google keeps its four colors.
interface Props {
  name: 'google' | 'facebook' | 'nextdoor';
  size?: number;
  mono?: boolean;
  class?: string;
}
const { name, size = 24, mono = false, class: className = '' } = Astro.props;
---

{
  name === 'google' &&
    (mono ? (
      <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class={className}>
        <path d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3zM12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22zm-5.6-8a6 6 0 0 1 0-3.9V7.5H3.1a10 10 0 0 0 0 9zM12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.5l3.3 2.6C7.2 7.7 9.4 5.9 12 5.9z" />
      </svg>
    ) : (
      <svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" class={className}>
        <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.6H24v9h11.8c-.5 2.8-2.1 5.1-4.4 6.7v5.5h7.1c4.2-3.9 6.6-9.6 6.6-16.6z" />
        <path fill="#34A853" d="M24 46c6 0 11-2 14.6-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.5 2.1-5.8 0-10.6-3.9-12.4-9.1H4.3v5.7C7.9 41.1 15.4 46 24 46z" />
        <path fill="#FBBC05" d="M11.6 28.2c-.5-1.3-.7-2.7-.7-4.2s.3-2.9.7-4.2v-5.7H4.3C2.8 17 2 20.4 2 24s.8 7 2.3 9.9l7.3-5.7z" />
        <path fill="#EA4335" d="M24 10.7c3.3 0 6.2 1.1 8.5 3.3l6.3-6.3C34.9 4.1 29.9 2 24 2 15.4 2 7.9 6.9 4.3 14.1l7.3 5.7c1.8-5.2 6.6-9.1 12.4-9.1z" />
      </svg>
    ))
}
{
  name === 'facebook' && (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <path fill={mono ? 'currentColor' : '#1877F2'} d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.6-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z" />
      {!mono && <path fill="#fff" d="M16.7 15.5l.5-3.5h-3.4V9.8c0-1 .5-1.9 2-1.9h1.5v-3s-1.4-.2-2.7-.2c-2.8 0-4.6 1.7-4.6 4.7V12h-3v3.5h3v8.4a12 12 0 0 0 3.8 0v-8.4z" />}
    </svg>
  )
}
{
  name === 'nextdoor' && (
    <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class={className}>
      <circle cx="12" cy="12" r="12" fill={mono ? 'currentColor' : '#8ED500'} />
      <path
        fill={mono ? 'var(--nd-cut, #000)' : '#fff'}
        d="M12.6 6.4c-2.7 0-4.4 1.6-5 2.7V7.6a1.2 1.2 0 0 0-1.2-1.2H4.3v1.7h.6c.4 0 .6.3.6.6v8.9h2.6v-5.4c0-2 1.6-3.7 4.4-3.7 2.4 0 3.9 1.6 3.9 3.7v5.4H19v-5.7c0-3.3-2.6-5.5-6.4-5.5z"
      />
    </svg>
  )
}
