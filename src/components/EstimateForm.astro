---
// Free-estimate form. Same fields as the WordPress form (name, phone, email,
// city, state, zip, message) plus an optional service picker. Posts to the
// Vercel function /api/estimate (Resend email) — see api/estimate.js.
import { SERVICES, CONTACT, ESTIMATE_ENDPOINT } from '../consts';

interface Props {
  /** Unique per instance so two forms on a page never share element ids. */
  id: string;
  /** Pre-select a service (service detail pages). */
  service?: string;
}
const { id, service = '' } = Astro.props;

const field = 'form-field w-full rounded-lg border border-line bg-paper px-4 py-3 text-[0.95rem] text-ink placeholder:text-muted/70 outline-none transition-[border-color,box-shadow] focus:border-primary focus:ring-[3px] focus:ring-primary/20';
const label = 'mb-1.5 block text-[0.78rem] font-semibold text-ink';
---

<form class="estimate-form relative grid grid-cols-6 gap-4" action={ESTIMATE_ENDPOINT} method="post" data-estimate-form novalidate>
  <label class="col-span-6 sm:col-span-3">
    <span class={label}>Full name *</span>
    <input class={field} type="text" name="name" id={`${id}-name`} autocomplete="name" required placeholder="Your full name" />
  </label>
  <label class="col-span-6 sm:col-span-3">
    <span class={label}>Phone *</span>
    <input class={field} type="tel" name="phone" id={`${id}-phone`} autocomplete="tel" inputmode="tel" required placeholder="(952) 000-0000" />
  </label>
  <label class="col-span-6">
    <span class={label}>Email *</span>
    <input class={field} type="email" name="email" id={`${id}-email`} autocomplete="email" required placeholder="you@email.com" />
  </label>
  <label class="col-span-6 sm:col-span-3">
    <span class={label}>City</span>
    <input class={field} type="text" name="city" id={`${id}-city`} autocomplete="address-level2" placeholder="Apple Valley" />
  </label>
  <label class="col-span-3 sm:col-span-1">
    <span class={label}>State</span>
    <input class={field} type="text" name="state" id={`${id}-state`} autocomplete="address-level1" value="MN" maxlength="2" />
  </label>
  <label class="col-span-3 sm:col-span-2">
    <span class={label}>Zip</span>
    <input class={field} type="text" name="zip" id={`${id}-zip`} autocomplete="postal-code" inputmode="numeric" maxlength="10" placeholder="55124" />
  </label>
  <label class="col-span-6">
    <span class={label}>Service</span>
    <select class={field} name="service" id={`${id}-service`}>
      <option value="">Select a service (optional)</option>
      {SERVICES.map((s) => <option value={s.name} selected={s.name === service}>{s.name}</option>)}
      <option value="Other / Not sure">Other / Not sure</option>
    </select>
  </label>
  <label class="col-span-6">
    <span class={label}>Tell us about your project</span>
    <textarea class:list={[field, 'resize-y']} name="message" id={`${id}-message`} rows={4} placeholder="Rooms, surfaces, timing…"></textarea>
  </label>

  <!-- Honeypot: hidden from people, irresistible to bots. -->
  <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
    <label>Leave this empty <input type="text" name="hp_website_confirm" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="col-span-6 mt-1">
    <button type="submit" class="btn btn-primary w-full !py-4 disabled:opacity-60">
      <span data-label>Request My Free Estimate</span>
    </button>
    <p class="mt-3 text-center text-[0.85rem] text-muted">
      Prefer to talk? Call or text <a href={`tel:${CONTACT.phoneTel}`} class="font-semibold text-link underline underline-offset-4">{CONTACT.phoneDisplay}</a>
    </p>
    <p class="form-status mt-3 hidden text-center text-sm font-semibold" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-estimate-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const btnLabel = btn.querySelector<HTMLElement>('[data-label]')!;
    const idle = btnLabel.textContent ?? '';
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.classList.remove('hidden', 'text-red-600', 'text-emerald-700');
      status.classList.add(ok ? 'text-emerald-700' : 'text-red-600');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      if (!name || !phone || !email) return show('Please add your name, phone and email.', false);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return show('Please enter a valid email address.', false);

      btn.disabled = true;
      btnLabel.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error || 'Something went wrong.');
        form.reset();
        show('Thanks! Pedro will reach out shortly to schedule your free estimate.', true);
        btnLabel.textContent = 'Sent ✓';
        (window as any).gtag?.('event', 'generate_lead', { service: data.get('service') || 'unspecified' });
      } catch (err) {
        show(`${(err as Error).message} You can also call or text (952) 769-3906.`, false);
        btn.disabled = false;
        btnLabel.textContent = idle;
      }
    });
  });
</script>
