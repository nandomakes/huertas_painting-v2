---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Process from '../../components/Process.astro';
import CtaBand from '../../components/CtaBand.astro';
import EstimateSection from '../../components/EstimateSection.astro';
import Footer from '../../components/Footer.astro';
import CallFab from '../../components/CallFab.astro';
import Icon from '../../components/Icon.astro';
import { SERVICES, SITE, BACKGROUNDS } from '../../consts';

const title = "Painting Services in Apple Valley, MN | Huerta's Painting";
const description =
  'Interior & exterior painting, drywall repair, ceiling texturing & repair, and deck refinishing across Apple Valley and the Twin Cities South Metro.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services/` },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="content">
    <Hero
      variant="page"
      eyebrow="Our services"
      title="Residential Painting Services"
      sub="Whether you need interior painting, exterior painting, drywall repair or ceiling painting, our team of painting professionals is ready to help."
      image={BACKGROUNDS.services}
      imageAlt="Bright, freshly painted living room"
      focus="50% 50%"
      crumbs={[{ href: '/', label: 'Home' }, { label: 'Services' }]}
    />

    {
      SERVICES.map((s, i) => (
        // `id` keeps the old WordPress anchors (/services/#interior) working.
        <section id={s.anchor} class:list={['section', i % 2 === 0 ? 'bg-paper' : 'bg-surface']}>
          <div class="wrap grid items-center gap-10 md:grid-cols-2 md:gap-14">
            <div class:list={['reveal', i % 2 === 1 && 'md:order-2']}>
              <Image
                src={s.image}
                alt={`${s.name} by Huerta's Painting`}
                widths={[480, 590]}
                sizes="(min-width: 768px) 32rem, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                class="aspect-[59/50] w-full rounded-card object-cover"
              />
            </div>
            <div>
              <p class="reveal eyebrow text-muted">{s.num}</p>
              <h2 class="reveal h2 mt-2">{s.name}</h2>
              <p class="reveal mt-5 text-body">{s.intro}</p>
              <p class="reveal mt-5 font-semibold text-ink">{s.bulletsLead}</p>
              <ul class="reveal mt-3 space-y-2.5">
                {s.bullets.map((b) => (
                  <li class="flex gap-3">
                    <Icon name="check" size={22} stroke={2.4} class="mt-0.5 shrink-0 text-link" />
                    <span class="text-body">{b}</span>
                  </li>
                ))}
              </ul>
              <div class="reveal mt-8 flex flex-wrap gap-3">
                <a href={`/services/${s.slug}/`} class="btn btn-outline">Learn More</a>
                <a href="#estimate" class="btn btn-primary">Schedule Free Estimate</a>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <Process tone="surface" />
    <EstimateSection />
    <CtaBand />
  </main>
  <Footer />
  <CallFab />
</Layout>
