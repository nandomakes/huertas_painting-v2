---
// Review funnel, 👎 branch: a private message straight to Pedro (same
// fields as the WordPress form: name, email, message — plus optional phone).
// Posts to the Vercel function /api/feedback.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FunnelShell from '../components/FunnelShell.astro';
import Footer from '../components/Footer.astro';
import CallFab from '../components/CallFab.astro';
import { CONTACT, FEEDBACK_ENDPOINT, REVIEW_FUNNEL } from '../consts';

const field =
  'form-field w-full rounded-lg border border-line bg-paper px-4 py-3 text-[0.95rem] text-ink placeholder:text-muted/70 outline-none transition-[border-color,box-shadow] focus:border-primary focus:ring-[3px] focus:ring-primary/20';
const label = 'mb-1.5 block text-[0.78rem] font-semibold text-ink';
---

<Layout title="Thanks for Your Feedback | Huerta's Painting" description="Send Huerta's Painting a private message about your project." noindex>
  <Header />
  <main id="content">
    <FunnelShell
      title="Thanks for Your Feedback"
      sub="We're sorry your experience wasn't what you expected. Tell us what happened — Pedro reads every message personally and will get back to you."
    >
      <form class="feedback-form relative mx-auto mt-10 grid max-w-[34rem] gap-4 text-left" action={FEEDBACK_ENDPOINT} method="post" data-feedback-form novalidate>
        <label>
          <span class={label}>Name *</span>
          <input class={field} type="text" name="name" autocomplete="name" required placeholder="Your name" />
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label>
            <span class={label}>Email *</span>
            <input class={field} type="email" name="email" autocomplete="email" required placeholder="you@email.com" />
          </label>
          <label>
            <span class={label}>Phone</span>
            <input class={field} type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="Optional" />
          </label>
        </div>
        <label>
          <span class={label}>Message *</span>
          <textarea class:list={[field, 'resize-y']} name="message" rows={5} required placeholder="What could we have done better?"></textarea>
        </label>
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label>Leave this empty <input type="text" name="hp_website_confirm" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn btn-primary mt-1 w-full !py-4 disabled:opacity-60"><span data-label>Send My Feedback</span></button>
        <p class="form-status hidden text-center text-sm font-semibold" role="status" aria-live="polite"></p>
      </form>
      <p class="mt-8 text-[0.92rem] text-body">
        Prefer to talk? Call or text Pedro at
        <a href={`tel:${CONTACT.phoneTel}`} class="font-semibold text-link underline underline-offset-4">{CONTACT.phoneDisplay}</a>.
      </p>
      <a href={REVIEW_FUNNEL.start} class="link-arrow mt-3 py-3">← Back</a>
    </FunnelShell>
  </main>
  <Footer />
  <CallFab />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-feedback-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const btnLabel = btn.querySelector<HTMLElement>('[data-label]')!;
    const show = (msg: string, ok: boolean) => {
      status.textContent = msg;
      status.classList.remove('hidden', 'text-red-600', 'text-emerald-700');
      status.classList.add(ok ? 'text-emerald-700' : 'text-red-600');
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const message = String(data.get('message') || '').trim();
      if (!name || !email || !message) return show('Please add your name, email and message.', false);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return show('Please enter a valid email address.', false);
      btn.disabled = true;
      btnLabel.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: data });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error || 'Something went wrong.');
        form.reset();
        show('Thank you. Your message went straight to Pedro — he will be in touch soon.', true);
        btnLabel.textContent = 'Sent ✓';
      } catch (err) {
        show(`${(err as Error).message} You can also call or text (952) 769-3906.`, false);
        btn.disabled = false;
        btnLabel.textContent = 'Send My Feedback';
      }
    });
  }
</script>
