---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Reviews from '../components/Reviews.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import WhyUs from '../components/WhyUs.astro';
import Process from '../components/Process.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import Faq from '../components/Faq.astro';
import EstimateSection from '../components/EstimateSection.astro';
import Footer from '../components/Footer.astro';
import CallFab from '../components/CallFab.astro';
import { HOME_FAQS, faqPageSchema } from '../consts';

// Conversion-first landing page on the Paris Painting structure:
// hero (van photo + phone + estimate card) → proof bar → reviews →
// services → mid-page CTA → why us → 4-step process → service areas
// (city pages) → FAQ → estimate form.
const schema = [faqPageSchema(HOME_FAQS)];
---

<Layout schema={schema}>
  <Header />
  <main id="content">
    <Hero
      eyebrow="Family-owned house painters in Apple Valley, MN"
      title="Proud to Paint the South Metro"
      sub="Interior and exterior painting, drywall and ceiling repair, and deck refinishing — with a free in-home estimate and the owner on every job."
    />
    <TrustBar />
    <Reviews />
    <ServicesGrid />
    <CtaBand />
    <WhyUs />
    <Process tone="surface" />
    <ServiceAreas tone="paper" />
    <Faq items={HOME_FAQS} tone="surface" />
    <EstimateSection />
  </main>
  <Footer />
  <CallFab />
</Layout>
