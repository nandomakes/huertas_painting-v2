---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Reviews from '../components/Reviews.astro';
import IntroSplit from '../components/IntroSplit.astro';
import Recognition from '../components/Recognition.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Guarantees from '../components/Guarantees.astro';
import FeatureSplit from '../components/FeatureSplit.astro';
import Process from '../components/Process.astro';
import Glance from '../components/Glance.astro';
import Story from '../components/Story.astro';
import Faq from '../components/Faq.astro';
import EstimateSection from '../components/EstimateSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import CallFab from '../components/CallFab.astro';
import { HOME_FAQS, faqPageSchema } from '../consts';

// Section order follows paris-painting.com: hero + trust strip → reviews →
// intro split → recognition cards → services → guarantees → feature split →
// 4-step process → at-a-glance + areas → story → founder → closing band.
// FAQ + estimate form sit before the band for conversion and SEO.
const schema = [faqPageSchema(HOME_FAQS)];
---

<Layout schema={schema}>
  <Header />
  <main id="content">
    <Hero
      eyebrow="Family-owned house painters in Apple Valley, MN"
      title="Proud to Paint the South Metro"
      sub="Interior and exterior painting, drywall and ceiling repair, and deck refinishing — with a free in-home estimate and the owner on every job."
    />
    <Reviews />
    <IntroSplit />
    <Recognition />
    <ServicesGrid />
    <Guarantees />
    <FeatureSplit />
    <Process />
    <Glance />
    <Story />
    <Faq items={HOME_FAQS} />
    <EstimateSection tone="surface" />
    <CtaBand />
  </main>
  <Footer />
  <CallFab />
</Layout>
