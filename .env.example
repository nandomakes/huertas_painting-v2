# Estimate form (api/estimate.js) — emails every free-estimate request.
# Set these in Vercel → Project → Settings → Environment Variables (Production
# AND Preview). They're read at request time, not build time.
#   1. Create a free account at resend.com → API Keys → create a "Sending" key.
#   2. Until huertaspaintingllc.com is verified in Resend (Domains → add DNS
#      records), the default sender onboarding@resend.dev can ONLY email the
#      address that owns the Resend account. Verify the domain, then set
#      ESTIMATE_FROM_EMAIL.
RESEND_API_KEY=
# Who gets notified. Comma-separate for several recipients.
ESTIMATE_NOTIFY_EMAIL=huertaspaintingllc@gmail.com
# Optional, e.g. "Huerta's Painting Website <estimates@huertaspaintingllc.com>"
ESTIMATE_FROM_EMAIL=

# Optional GA4 override (otherwise GA4_ID in src/consts.ts; empty = no tag).
PUBLIC_GA4_ID=
